class PiLogicAlphabetCenter:
    def __init__(self):
        self.alphabet = self._build_circular_alphabet()
        self.operators = ReadingOperators()
        self.quantum_states = {}
    
    def _build_circular_alphabet(self):
        """Construct the Japanese-centered alphabet"""
        base = "ABCDEFGHIJKLM"
        center = "なか"
        rest = "NOPQRSTUVWXYZ"
        
        return {
            'progressive': base + center + rest,
            'regressive': rest[::-1] + center + base[::-1],
            'circular': base + center + rest + "→" + base  # Loop back to A
        }
    
    def read_text(self, text, mode='progressive', alpha=None, beta=None):
        """Read text using specified mode"""
        if mode == 'progressive':
            return self.operators.progressive_operator(text)
        elif mode == 'regressive':
            return self.operators.regressive_operator(text)
        elif mode == 'harmonic':
            if alpha is None or beta is None:
                alpha, beta = 1/math.sqrt(2), 1/math.sqrt(2)
            return self.operators.harmonic_operator(text, alpha, beta)
        else:
            raise ValueError("Mode must be 'progressive', 'regressive', or 'harmonic'")
    
    def create_quantum_state(self, state_id, alpha, beta):
        """Create a quantum reading state"""
        self.quantum_states[state_id] = QuantumReadingState(alpha, beta)
        return self.quantum_states[state_id]
    
    def measure_quantum_state(self, state_id, text):
        """Measure a quantum state and return collapsed reading"""
        if state_id not in self.quantum_states:
            raise ValueError("Quantum state not found")
        
        state = self.quantum_states[state_id]
        direction = state.measure()
        
        if direction == 'LTR':
            return self.operators.progressive_operator(text)
        else:
            return self.operators.regressive_operator(text)
